    "aws4fetch": "1.0.20",
    "hono": "4.13.12",
    "katex": "0.19.0",
    "modern-pdf-lib": "0.40.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/workers-types": "5.20260827.1",
    "@types/node": "26.4.0",
    "typescript": "7.1.0-dev.20260826.1",
    "vitest": "5.0.0-rc.2",
    "wrangler": "4.127.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
